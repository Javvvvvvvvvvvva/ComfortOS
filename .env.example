# Development-only public demo. Production must use mapbox-managed, osrm-managed,
# or osrm-self-hosted.
ROUTING_PROVIDER=osrm-public
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_REQUEST_TIMEOUT_MS=8000
# ROUTING_PROVIDER=mapbox-managed
# MAPBOX_ACCESS_TOKEN=replace-with-a-dedicated-mapbox-token
# MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
# Optional Mapbox walking preference from -1 to 1. The default is neutral.
# MAPBOX_WALKWAY_BIAS=0
# ROUTING_PROVIDER=osrm-self-hosted
# ROUTING_OSRM_BASE_URL=http://127.0.0.1:5000
NEXT_PUBLIC_BASEMAP_PROVIDER=osm-community
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Production managed basemap. Tiles are proxied server-side so the token is not
# embedded in the browser bundle.
# NEXT_PUBLIC_BASEMAP_PROVIDER=mapbox-managed
# MAPBOX_MAP_STYLE_OWNER=mapbox
# MAPBOX_MAP_STYLE_ID=streets-v12
# MAPBOX_STYLES_BASE_URL=https://api.mapbox.com/styles/v1
# BASEMAP_REQUEST_TIMEOUT_MS=8000
# Custom contracted tile service:
# NEXT_PUBLIC_BASEMAP_PROVIDER=custom
# NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=© Example Maps © OpenStreetMap contributors
# Development-only public demo. Production should use mapbox-managed or a
# contracted self-hosted Photon endpoint.
GEOCODING_PROVIDER=photon-public
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_COUNTRY_CODE=US
GEOCODING_LANGUAGE=en
GEOCODING_REQUEST_TIMEOUT_MS=8000
# GEOCODING_PROVIDER=mapbox-managed
# MAPBOX_SEARCH_ACCESS_TOKEN=replace-with-a-dedicated-mapbox-token
# Falls back to MAPBOX_ACCESS_TOKEN when a dedicated search token is not set.
# MAPBOX_SEARCH_BASE_URL=https://api.mapbox.com/search/searchbox/v1
# GEOCODING_PROVIDER=photon-self-hosted
# GEOCODING_BASE_URL=https://your-photon.example.com
WEATHER_BASE_URL=https://api.weather.gov
WEATHER_USER_AGENT=ComfortOS/1.0 (contact@example.com)
BUILDING_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
BUILDING_PROVIDER=overpass
# Production query service:
# BUILDING_PROVIDER=building-query-service
# BUILDING_QUERY_SERVICE_URL=https://environment-data.example.com
# BUILDING_QUERY_SERVICE_TOKEN=replace-with-a-private-service-token
# BUILDING_QUERY_SERVICE_TIMEOUT_MS=6000
# BUILDING_QUERY_SERVICE_MAX_RESPONSE_BYTES=8388608
# BUILDING_QUERY_SERVICE_MAX_BUILDINGS=25000
# BUILDING_PROVIDER=local-overture
# BUILDING_LOCAL_OVERTURE_STORE_DIR=/absolute/path/to/local/overture/store

# Rain cover stays optional for a Phoenix-primary beta. Set REQUIRE_RAIN_COVER=true
# only when the production covered-feature service and reviewed dataset are active.
REQUIRE_RAIN_COVER=false
COVERED_FEATURE_PROVIDER=disabled
# COVERED_FEATURE_PROVIDER=covered-query-service
# COVERED_FEATURE_QUERY_SERVICE_URL=https://environment-data.example.com
# COVERED_FEATURE_QUERY_SERVICE_TOKEN=replace-with-a-private-service-token
# COVERED_FEATURE_QUERY_SERVICE_TIMEOUT_MS=5000
# COVERED_FEATURE_QUERY_SERVICE_MAX_RESPONSE_BYTES=2097152
# COVERED_FEATURE_QUERY_SERVICE_MAX_FEATURES=10000

# Environment data service runtime. BUILDING_LOCAL_OVERTURE_STORE_DIRS accepts
# comma-separated immutable stores for the declared capability regions.
# ENVIRONMENT_QUERY_SERVICE_TOKEN=replace-with-a-private-service-token
# ENVIRONMENT_QUERY_SERVICE_MAX_BBOX_SPAN_DEGREES=0.25
# ENVIRONMENT_QUERY_SERVICE_TIMEOUT_MS=8000
# ENVIRONMENT_QUERY_SERVICE_MAX_LOADED_STORES=8
# BUILDING_LOCAL_OVERTURE_STORE_DIRS=/data/minneapolis,/data/seattle,/data/phoenix
# BUILDING_LOCAL_OVERTURE_STORE_ROOTS=/data/us
# COVERED_FEATURE_STATIC_GEOJSON=/data/seattle-covered-features.geojson
# COVERED_FEATURE_REGION=seattle-preview

# External-beta trust and operations gate.
NEXT_PUBLIC_SUPPORT_URL=https://support.example.com/comfortos
LEGAL_REVIEW_APPROVED=false
OBSERVABILITY_PROVIDER=console
OBSERVABILITY_ALERTS_CONFIGURED=false
# HEALTHCHECK_TOKEN=replace-with-a-private-healthcheck-token
# COMFORTOS_ENVIRONMENT=production
# APP_VERSION=git-commit-or-release-id
