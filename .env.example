# Development-only public demo. Production must use mapbox-managed, osrm-managed,
# or osrm-self-hosted.
ROUTING_PROVIDER=osrm-public
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_REQUEST_TIMEOUT_MS=8000
# ROUTING_PROVIDER=mapbox-managed
# MAPBOX_ACCESS_TOKEN=replace-with-a-dedicated-mapbox-token
# MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
# Optional Mapbox walking preference from -1 to 1. The default is neutral.
# MAPBOX_WALKWAY_BIAS=0
# ROUTING_PROVIDER=osrm-self-hosted
# ROUTING_OSRM_BASE_URL=http://127.0.0.1:5000
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Development-only public demo. Production should use mapbox-managed or a
# contracted self-hosted Photon endpoint.
GEOCODING_PROVIDER=photon-public
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_COUNTRY_CODE=US
GEOCODING_LANGUAGE=en
GEOCODING_REQUEST_TIMEOUT_MS=8000
# GEOCODING_PROVIDER=mapbox-managed
# MAPBOX_SEARCH_ACCESS_TOKEN=replace-with-a-dedicated-mapbox-token
# Falls back to MAPBOX_ACCESS_TOKEN when a dedicated search token is not set.
# MAPBOX_SEARCH_BASE_URL=https://api.mapbox.com/search/searchbox/v1
# GEOCODING_PROVIDER=photon-self-hosted
# GEOCODING_BASE_URL=https://your-photon.example.com
WEATHER_BASE_URL=https://api.weather.gov
WEATHER_USER_AGENT=ComfortOS Stage 1 (contact: replace-with-project-contact)
BUILDING_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
BUILDING_PROVIDER=overpass
# BUILDING_PROVIDER=local-overture
# BUILDING_LOCAL_OVERTURE_STORE_DIR=/absolute/path/to/local/overture/store
