FROM node:22.13.0-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --include=dev

COPY tsconfig.json ./
COPY lib ./lib
COPY scripts ./scripts

RUN npm run environment:build

FROM node:22.13.0-alpine3.20

ARG TIGRISFS_VERSION=1.2.2
ARG TIGRISFS_ARCH=amd64
ARG TIGRISFS_SHA256=fd0c19c5c1d19eebd466cd4b6ce8f38286bedad6d792e6202cc3c916ce5e4281

RUN apk add --no-cache ca-certificates curl fuse su-exec \
  && curl --fail --location --silent --show-error \
    "https://github.com/tigrisdata/tigrisfs/releases/download/v${TIGRISFS_VERSION}/tigrisfs_${TIGRISFS_VERSION}_linux_${TIGRISFS_ARCH}.tar.gz" \
    --output /tmp/tigrisfs.tar.gz \
  && echo "${TIGRISFS_SHA256}  /tmp/tigrisfs.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/tigrisfs.tar.gz -C /usr/local/bin \
  && rm /tmp/tigrisfs.tar.gz \
  && chmod 0755 /usr/local/bin/tigrisfs \
  && printf 'user_allow_other\n' >> /etc/fuse.conf \
  && mkdir -p /mnt/r2 /app/deployment \
  && chown node:node /app/deployment

ENV NODE_ENV=production
ENV PORT=8787

WORKDIR /app

COPY --from=build /app/dist-environment/service.mjs ./service.mjs
COPY --from=build /app/dist-environment/probe-r2-mount.mjs ./probe-r2-mount.mjs
COPY deploy/cloudflare-environment/generated/deployment ./deployment
COPY deploy/cloudflare-environment/start-r2-service.sh /usr/local/bin/start-r2-service

RUN chmod 0555 /usr/local/bin/start-r2-service \
  && chown -R node:node /app

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/start-r2-service"]
