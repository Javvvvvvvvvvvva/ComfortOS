{
  "name": "comfortos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "buildings:ingest:overture": "node --import tsx scripts/ingest-overture-buildings.ts",
    "data:buildings": "node --import tsx scripts/build-overture-buildings.ts",
    "data:buildings:minneapolis": "node --import tsx scripts/build-minneapolis-overture-buildings.ts",
    "data:buildings:seattle": "node --import tsx scripts/build-overture-buildings.ts --region seattle",
    "data:buildings:phoenix": "node --import tsx scripts/build-overture-buildings.ts --region phoenix",
    "data:buildings:plan:states": ".venv/bin/python scripts/plan-us-state-building-partitions.py",
    "data:buildings:state": "node --import tsx scripts/build-us-state-overture-buildings.ts",
    "data:buildings:rollout": "node --import tsx scripts/build-us-overture-rollout.ts",
    "data:buildings:audit": "node --import tsx scripts/audit-us-overture-build-progress.ts",
    "data:buildings:index": "node --import tsx scripts/index-overture-building-store.ts",
    "data:covered-features:overpass": "node --import tsx scripts/extract-covered-features-overpass.ts",
    "buildings:serve": "node --import tsx scripts/serve-building-query-service.ts",
    "environment:serve": "node --import tsx scripts/serve-building-query-service.ts",
    "environment:build": "esbuild scripts/serve-building-query-service.ts --bundle --platform=node --format=esm --target=node22 --tsconfig=tsconfig.json --outfile=dist-environment/service.mjs",
    "buildings:benchmark": "node --import tsx scripts/benchmark-building-providers.ts",
    "routes:validate:comfort": "node --import tsx scripts/validate-comfort-routes.ts",
    "routes:validate:comfort:local": "node --import tsx scripts/validate-comfort-routes-local.ts",
    "research:routing:stage6": "node --import tsx scripts/run-stage-6-routing-research.ts",
    "routes:validate:stage7": "node --import tsx scripts/validate-stage-7-progressive-routes.ts",
    "routes:validate:stage7.5": "node --import tsx scripts/validate-stage-7-5-latency.ts",
    "routes:validate:stage8": "node --import tsx scripts/validate-stage-8-seattle-rain.ts",
    "routes:validate:stage8.5": "node --import tsx scripts/validate-stage-8-5-covered-network.ts",
    "routes:validate:stage9": "node --import tsx scripts/validate-stage-9-phoenix-heat.ts",
    "routes:validate:stage9.6:minneapolis": "node --import tsx scripts/validate-stage-9-6-minneapolis.ts",
    "routes:validate:region-rollout": "node --import tsx scripts/validate-region-rollout.ts",
    "routing:benchmark": "node --import tsx scripts/benchmark-routing-provider.ts",
    "routing:equivalence": "node --import tsx scripts/audit-routing-provider-equivalence.ts",
    "smoke:stage10": "node --import tsx scripts/smoke-stage-10-mvp.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "@types/suncalc": "^1.9.2",
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^6.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
